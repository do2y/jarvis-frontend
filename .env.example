# 이 파일을 .env.local 로 복사해 값 채우기 (.env.local 은 커밋 안 됨)

# 브라우저에서 axios가 쓰는 baseURL. 빈 값 = 상대경로(/api/...)로 나가
# app/api/[...path]/route.ts 프록시가 백엔드로 전달(CORS·쿠키 문제 없음).
# 빌드 시점에 번들에 박히므로 배포 이미지 빌드 때 주입해야 한다.
NEXT_PUBLIC_API_BASE_URL=

# Open Graph / canonical 등 절대 URL 메타데이터에 쓸 서비스 주소.
# 서버가 런타임에 읽으므로 컨테이너 실행 시점에 주입하면 된다.
# 예: https://narvis.shop
SITE_URL=

# 서버(프록시 Route Handler)가 실제로 요청을 보낼 백엔드 주소.
# 브라우저용과 분리하는 이유: 컨테이너 안에서는 백엔드가 다른 호스트일 수 있다.
# 로컬 백엔드: http://localhost:8080 / 배포 백엔드에 붙으려면 그 주소를 넣는다.
API_PROXY_TARGET=http://localhost:8080

# 백엔드 없이 화면을 띄운다 (1 = 켬).
# 목 데이터는 src/mocks/fixtures.ts, 경로 매핑은 src/mocks/handlers.ts.
# 로컬 프록시(app/api/[...path])와 SSR 조회(shared/api/server.ts) 양쪽에 걸린다.
# 값이 "1" 일 때만 켜지고, NODE_ENV 로는 막지 않는다 — 프로덕션 빌드(npm run start)로
# 시연할 때도 목이 필요하기 때문. 실서버에 붙이려면 이 값을 비운다.
# 사용: MOCK_API=1 npm run dev
MOCK_API=
